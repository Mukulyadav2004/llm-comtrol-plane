# Copy this to .env and fill in values
POSTGRES_USER=broker
POSTGRES_PASSWORD=broker
POSTGRES_DB=broker_db
JWT_SECRET=change-me-in-production
AWS_REGION=us-east-1
S3_BUCKET=

# ── Provider credentials ─────────────────────────────────────────────────────
# Read by the gateway at request time. A route names one of these variables in
# its `api_key_env` field; the value never leaves this file and the gateway's
# environment. Leave a line blank to disable that provider.
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
